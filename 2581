def sieve(max_limit):
    """埃氏筛，生成max_limit以内的质数标记数组"""
    is_prime = [True] * (max_limit + 1)
    is_prime[0] = is_prime[1] = False  # 0和1不是质数
    for i in range(2, int(max_limit ** 0.5) + 1):
        if is_prime[i]:
            # 标记i的倍数为非质数
            for j in range(i * i, max_limit + 1, i):
                is_prime[j] = False
    return is_prime

# 预处理1~10000的质数标记（题目N最大为10000）
MAX = 10000
prime_table = sieve(MAX)

# 读取输入
M = int(input())
N = int(input())

# 收集[M, N]区间内的质数
primes_in_range = [x for x in range(M, N + 1) if prime_table[x]]

# 输出结果
if not primes_in_range:
    print(-1)
else:
    print(sum(primes_in_range))
    print(min(primes_in_range))
