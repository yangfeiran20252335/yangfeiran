def sum_digits(x):
    s = 0
    while x > 0:
        s += x % 10
        x = x // 10
    return s
max_num = 10000
is_self = [True] * (max_num + 1)
for n in range(1, max_num + 1):
    dn = n + sum_digits(n)
    if dn <= max_num:
        is_self[dn] = False
for x in range(1, max_num + 1):
    if is_self[x]:
        print(x)
