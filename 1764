import sys

def main():
    input = sys.stdin.read().split()
    ptr = 0
    N = int(input[ptr])
    ptr += 1
    M = int(input[ptr])
    ptr += 1
    heard = set()
    for _ in range(N):
        heard.add(input[ptr])
        ptr += 1
    result = []
    for _ in range(M):
        name = input[ptr]
        ptr += 1
        if name in heard:
            result.append(name)
    result.sort()
    print(len(result))
    for name in result:
        print(name)

if __name__ == "__main__":
    main()
