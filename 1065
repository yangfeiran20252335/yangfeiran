def is_hansu(x):
    digits = []
    while x > 0:
        digits.append(x % 10)
        x = x // 10
    digits = digits[::-1]
    if len(digits) <= 2:
        return True
    diff = digits[1] - digits[0]
    for i in range(2, len(digits)):
        if digits[i] - digits[i-1] != diff:
            return False
    return True
N = int(input())
count = 0
for num in range(1, N + 1):
    if is_hansu(num):
        count += 1
print(count)
